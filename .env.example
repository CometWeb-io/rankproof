# ── Database ───────────────────────────────────────────────────────────────
# Without this variable the app uses the embedded PGLite (Postgres in WASM),
# so it works out of the box — that in-memory history resets on restart.
# DATABASE_URL=postgres://user:password@host/database

# ── Scan budgets ───────────────────────────────────────────────────────────
# A scan queries other people's servers. Higher values mean more thorough
# results, but slower scans and a greater chance of being served a CAPTCHA.
RANKPROOF_SCAN_PROFILE=standard
RANKPROOF_SCAN_BUDGET_MS=58000
RANKPROOF_LIGHT_BUDGET_MS=20000
RANKPROOF_HOST_CONCURRENCY=3
RANKPROOF_MAX_BACKLINKS=400
RANKPROOF_MAX_VERIFY=64

# ── SERP defaults ──────────────────────────────────────────────────────────
RANKPROOF_ENGINES=bing,duckduckgo,mojeek
RANKPROOF_MARKET=pl
RANKPROOF_DEVICE=desktop
RANKPROOF_SERP_DEPTH=10
# Optional competitor Google SERP via self-hosted OpenSERP-compatible provider:
# RANKPROOF_GOOGLE_PROVIDER_URL=https://serp-provider.example.com

# ── Behaviour ──────────────────────────────────────────────────────────────
# Set to 0 to skip Web scan history (useful in CI). Standalone CLI exports do not write Web history.
RANKPROOF_PERSIST_HISTORY=1
# Introduce yourself honestly — site administrators appreciate it, and a real
# contact URL means they can email you instead of banning you.
RANKPROOF_USER_AGENT=RankProof/8.1 (+https://github.com/CometWeb-io/rankproof)
# Directory for the on-disk cache with conditional revalidation. Repeat scans
# then send If-None-Match and take a 304 instead of re-downloading. Set to 1
# to use a temporary directory.
# RANKPROOF_CACHE_DIR=.cache/rankproof

# ── Google Search Console (optional) ────────────────────────────────────────
# Real clicks, impressions and Google positions for a property you own.
# Turns several estimates in the report into measurements.
# Setup: docs/search-console.md
# Used only by an explicit local `scan --webmaster`; Web/API scans cannot enable these credentials.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Alternatively, a short-lived token for a quick test:
# GOOGLE_OAUTH_ACCESS_TOKEN=

# ── Bing Webmaster Tools (optional) ─────────────────────────────────────────
# A single API key, no OAuth. A useful cross-check, since our scraped
# positions lean on Bing's index.
# BING_WEBMASTER_API_KEY=

# ── HTTP API (scripts/serve-api.mjs) ───────────────────────────────────────
RANKPROOF_RATE_LIMIT=20
RANKPROOF_RATE_WINDOW_MS=60000
# Required for non-loopback binding; keep the token private.
# RANKPROOF_API_TOKEN=
# Required outside loopback; production enables DNS pinning by default.
# RANKPROOF_PIN_DNS=1

# ── Agent HTTP/MCP (separate optional entrypoints) ─────────────────────────
# Default HTTP listener is 127.0.0.1:8788; browser origins are refused.
# RANKPROOF_AGENT_HOST=127.0.0.1
# RANKPROOF_AGENT_PORT=8788
# Optional restart-safe verifier history (Node22.13+, private directory/file).
# Without it, agent evidence expires from bounded process memory.
# See docs/agent-history.md; request bodies cannot select this operator path.
# RANKPROOF_AGENT_HISTORY_DB=/absolute/private-directory/history.sqlite
